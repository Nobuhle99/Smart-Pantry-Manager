<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Scrollable recipe information -->
    <ScrollView
        android:id="@+id/recipeScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/recipeButtonsContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Recipe name -->
            <TextView
                android:id="@+id/tvDetailRecipeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chicken Pasta"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp" />

            <!-- Ingredients heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ingredients"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Ingredients will be added here by Java -->
            <LinearLayout
                android:id="@+id/ingredientsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp" />

            <!-- Instructions heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Instructions"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Recipe instructions -->
            <TextView
                android:id="@+id/tvDetailInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recipe instructions will appear here."
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom navigation/action buttons -->
    <LinearLayout
        android:id="@+id/recipeButtonsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Try Recipe -->
        <Button
            android:id="@+id/btnTryRecipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Try Recipe"
            android:minHeight="48dp" />

        <!-- View Ingredients -->
        <Button
            android:id="@+id/btnViewIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Ingredients"
            android:minHeight="48dp"
            android:layout_marginTop="8dp" />

        <!-- Back -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textSize="16sp"
            android:minHeight="48dp"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>