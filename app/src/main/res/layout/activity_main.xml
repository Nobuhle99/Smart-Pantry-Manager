<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Back to Welcome -->
    <Button
        android:id="@+id/btnBackWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Back" />

    <!-- Page title -->
    <TextView
        android:id="@+id/tvPantryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Welcome to My Pantry"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Page description -->
    <TextView
        android:id="@+id/tvPantrySubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Manage your ingredients and discover delicious recipes."
        android:textSize="15sp" />

    <!-- Add Ingredient -->
    <Button
        android:id="@+id/btnAddIngredient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Add Ingredient" />

    <!-- My Pantry -->
    <Button
        android:id="@+id/btnMyPantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="My Pantry" />

    <!-- View Recipes -->
    <Button
        android:id="@+id/btnViewRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="View Recipes" />

    <!-- Suggested Recipe -->
    <Button
        android:id="@+id/btnSuggestedRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Suggested Recipes" />

</LinearLayout>